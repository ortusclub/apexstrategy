# Transactional email for the contact and event-registration forms.
# Copy to .env.local for local development; set the same two variables in
# Vercel → Project → Settings → Environment Variables for production.
#
# Without both of these, form submissions are logged but NOT emailed, and the
# forms tell the visitor to email info@apexstrategy.io directly instead.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender address on a domain verified in Resend
# (https://resend.com/domains). Must be a real address on apexstrategy.io.
RESEND_FROM_EMAIL=notifications@apexstrategy.io

# ─────────────────────────────────────────────────────────────────────────────
# Booking — every "Book a Call" link on the site
#
# The public URL of the team's Calendly booking page. This is NOT an API key:
# a Calendly booking page is public by design, so the only thing needed here
# is the same link you would paste into an email.
#
# Every Book a Call control links straight out to this URL in a new tab, and
# /book-a-call redirects to it. If the variable is missing, all of them fall
# back to the enquiry form at /contact#enquiry-form, so no button is dead.
#
# Example:
#   NEXT_PUBLIC_SCHEDULER_URL=https://calendly.com/<handle>/<event>
NEXT_PUBLIC_SCHEDULER_URL=https://calendly.com/YOUR_HANDLE/30min
